# .gitignore
# 用户硬约束: 不入库的临时/大文件/环境/数据

# Python
venv313/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
dist/
build/

# 日志和崩溃转储
logs/
*.log
server.log
server_stdout.log
*.dmp

# 数据和输出
data/
output/
output/**
!output/.gitkeep

# 环境和敏感
.env
.env.local
.env.*.local

# 临时
scratch/
*.tmp
*.parquet.tmp
.superpowers/

# 杂项
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
output_backup_*/
data/parquet/daily_backup_*/

# 敏感配置不入 git(2026-07-15 全项目审计 C1): 含飞书 webhook/账号ID/buy_signal_token
config/app_setting.json
*.bak
